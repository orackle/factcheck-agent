# --- LLM provider ---
# One of: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# Only needed if LLM_PROVIDER=ollama and it's not on the default port
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Search provider ---
# One of: duckduckgo | tavily
SEARCH_PROVIDER=duckduckgo

# Only needed if SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Agent tuning ---
MAX_SEARCH_ITERATIONS=2
RESULTS_PER_QUERY=4
MAX_DOCS_TO_FETCH=5
FETCH_TIMEOUT_SECONDS=10
MAX_DOC_CHARS=6000
LLM_TIMEOUT_SECONDS=60
